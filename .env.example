# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact delivery (Resend — https://resend.com)
# Without a key, messages are logged to the server console instead of sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=bereket.elias@aastustudent.edu.et
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Bot protection (Cloudflare Turnstile — https://turnstile.cloudflare.com)
# Without keys, the challenge is skipped (honeypot + rate limit still apply).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Rate limiting (optional Upstash Redis — falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_DOMAIN=
